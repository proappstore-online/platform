{
  "$comment": "End-to-end evaluation fixtures for the create-proappstore-app skill (#170). Each case drives the real provision_pas_app MCP tool through the test harness in packages/mcp/src/skill-create-app.evals.test.ts with the listed mocks and asserts on the tool's text. Classes: happy, template, confirm, rerun, blocker.",
  "org": "test-org",
  "input": { "app_id": "school-clubs", "name": "School Clubs", "description": "Coordinate school clubs." },
  "cases": [
    { "id": "dry-run-plan", "class": "happy", "title": "dry-run shows the template with status and reviewed commit and makes no changes",
      "args": { "dry_run": true }, "mocks": {},
      "expect": { "containsRegex": ["template: template-app \\(test-org/template-app@main, approved, reviewed commit [0-9a-f]{7}\\)", "create GitHub repo test-org/school-clubs", "call /v1/provision"], "createCalled": false, "provisionCalled": false } },
    { "id": "unknown-template-refused", "class": "template", "title": "an unknown template is refused even in dry-run, naming the approved ids",
      "args": { "dry_run": true, "template_repo": "starter-v2" }, "mocks": {},
      "expect": { "contains": ["Refused: unknown template \"starter-v2\"", "template-app", "list_templates"], "createCalled": false, "provisionCalled": false } },
    { "id": "non-admin-override-refused", "class": "template", "title": "a non-admin cannot override the catalogue",
      "args": { "confirm": true, "verify": false, "template_repo": "starter-v2", "allow_unapproved_template": true }, "mocks": {},
      "expect": { "contains": ["Refused", "requires a platform admin session"], "createCalled": false, "provisionCalled": false } },
    { "id": "missing-confirm-refused", "class": "confirm", "title": "a live call without confirm is refused before any mutation",
      "args": { "verify": false }, "mocks": {},
      "expect": { "contains": ["Refused", "confirm: true"], "createCalled": false, "provisionCalled": false } },
    { "id": "success-verified", "class": "happy", "title": "confirmed run creates the repo, records the copied revision and provisions",
      "args": { "confirm": true, "verify": false },
      "mocks": { "createRepo": { "ok": true, "status": 200 }, "templateHeadSha": "d8c2e08f32b8e30847b27c7092fd4b0e64341d2f", "provision": { "status": 200, "body": { "success": true, "appUrl": "https://school-clubs.proappstore.online", "dataWorkerUrl": "https://data-school-clubs.proappstore.online", "steps": [ { "name": "route", "status": "ok", "detail": "school-clubs.proappstore.online -> apps/school-clubs/" }, { "name": "create_d1", "status": "ok", "detail": "pas-data-school-clubs (db-1)" }, { "name": "deploy_worker", "status": "ok", "detail": "deployed" }, { "name": "record_app", "status": "ok", "detail": "creator: alice; template: template-app@d8c2e08f32b8e30847b27c7092fd4b0e64341d2f" } ] } } },
      "expect": { "contains": ["+ GitHub repo: created test-org/school-clubs from test-org/template-app", "+ Template revision: template-app@d8c2e08f32b8", "PAS app provisioned"], "createCalled": true, "provisionCalled": true, "provisionBody": { "template": "template-app", "templateRev": "d8c2e08f32b8e30847b27c7092fd4b0e64341d2f" } } },
    { "id": "rerun-existing-owned", "class": "rerun", "title": "re-running for an owned, already-created repo reuses it and re-provisions idempotently",
      "args": { "confirm": true, "verify": false },
      "mocks": { "createRepo": { "ok": false, "status": 422 }, "repoExists": true, "ownsApp": true, "templateHeadSha": "d8c2e08f32b8e30847b27c7092fd4b0e64341d2f", "provision": { "status": 200, "body": { "success": true, "steps": [ { "name": "route", "status": "skip", "detail": "already registered" }, { "name": "create_d1", "status": "skip", "detail": "pas-data-school-clubs already exists (db-1)" }, { "name": "record_app", "status": "ok", "detail": "creator: alice" } ] } } },
      "expect": { "contains": ["~ GitHub repo: test-org/school-clubs already exists", "PAS app provisioned"], "notContains": ["Error"], "createCalled": true, "provisionCalled": true } },
    { "id": "blocker-not-signed-in", "class": "blocker", "blocker": "credentials", "title": "no session → authentication required, nothing touched",
      "args": { "confirm": true }, "mocks": { "session": null },
      "expect": { "contains": ["authentication required"], "createCalled": false, "provisionCalled": false } },
    { "id": "blocker-read-only-mode", "class": "blocker", "blocker": "credentials", "title": "read-only server: dry-run still plans, the live call is blocked",
      "args": { "confirm": true, "verify": false }, "mocks": { "readOnly": true, "createRepo": { "ok": true, "status": 200 } },
      "expect": { "throwsContaining": "read-only mode", "createCalled": false, "provisionCalled": false, "dryRunStillWorks": true } },
    { "id": "blocker-other-owner", "class": "blocker", "blocker": "ownership", "title": "repo exists and the app record belongs to another account",
      "args": { "confirm": true, "verify": false },
      "mocks": { "createRepo": { "ok": false, "status": 422 }, "repoExists": true, "ownsApp": false, "listingStatus": 403 },
      "expect": { "contains": ["owned by another account"], "provisionCalled": false } },
    { "id": "blocker-template-not-flagged", "class": "blocker", "blocker": "template", "title": "the source repo is not a GitHub template",
      "args": { "confirm": true, "verify": false }, "mocks": { "createRepo": { "ok": false, "status": 404 } },
      "expect": { "contains": ["must exist and be marked as a GitHub template"], "provisionCalled": false } },
    { "id": "blocker-compliance-412", "class": "blocker", "blocker": "compliance", "title": "provisioning finishes with a compliance failure that names the rule",
      "args": { "confirm": true, "verify": false },
      "mocks": { "createRepo": { "ok": true, "status": 200 }, "templateHeadSha": "d8c2e08f32b8e30847b27c7092fd4b0e64341d2f", "provision": { "status": 412, "body": { "success": false, "steps": [ { "name": "compliance", "status": "fail", "detail": "1 rule(s) failed — No tracking SDKs: gtag in web/index.html (see https://docs.proappstore.online/standard/ui/#pas-ui-022)" } ] } } },
      "expect": { "contains": ["finished with issues", "No tracking SDKs", "pas-ui-022"], "provisionCalled": true } },
    { "id": "revision-unresolved-never-invented", "class": "happy", "title": "an unresolvable template head is reported as unknown and omitted from the payload",
      "args": { "confirm": true, "verify": false },
      "mocks": { "createRepo": { "ok": true, "status": 200 }, "templateHeadSha": null, "provision": { "status": 200, "body": { "success": true, "steps": [] } } },
      "expect": { "contains": ["~ Template revision: could not resolve"], "provisionCalled": true, "provisionBodyLacks": ["templateRev"] } }
  ]
}
